# LLM Provider Configuration
# Choose: "openai_compatible" (for local Ollama/vLLM) | "openai" (for OpenAI API) | "none" (deterministic fallback)
LLM_PROVIDER=openai_compatible

# For Local Ollama (default setup):
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.5-9b-fast:latest
EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_EMBED_BASE_URL=http://localhost:11434

# For Cloud OpenAI:
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Privacy & Remote Data Settings
# Set to true only if you allow dataset-derived metadata to leave your local machine
LLM_ALLOW_REMOTE_DATA=false
LLM_QUERY_GENERATION_ENABLED=true

# Model & Evaluation Hyperparameters
RANDOM_STATE=42
TEST_SIZE=0.2
MAX_RETRIEVAL_DOCS=5
LLM_MAX_TOKENS=8192
LLM_QUERY_MAX_TOKENS=4096
LLM_TIMEOUT=120
LOG_LEVEL=INFO
